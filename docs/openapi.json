          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "githubUsername": {
            "type": [
              "string",
              "null"
            ]
          },
          "githubVerified": {
            "type": "boolean",
