          },
          "pending": {
            "type": "object",
            "properties": {
              "respond": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Decisiones que esperan respuesta del usuario. Siempre 0 por ahora."
              },
              "review": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
