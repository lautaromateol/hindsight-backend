{
  "openapi": "3.1.0",
  "info": {
    "title": "Escolio API",
    "version": "0.0.0",
    "description": "API REST de Escolio. Todo error de los controladores usa `{ error: { code, message } }`. Cada controlador comprueba la sesión y responde 401 si falta."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desarrollo"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "hello",
        "summary": "Comprobación de vida",
        "responses": {
          "200": {
            "description": "Texto plano `Hello World!`.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "auth"
        ],
        "summary": "Usuario autenticado",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Id de usuario de Clerk.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getProfile",
        "tags": [
          "auth"
        ],
        "summary": "Perfil del usuario autenticado",
        "description": "Nombre e imagen vienen de Clerk. Cada llamada alinea el usuario de GitHub con Clerk: si el usuario tiene una cuenta de GitHub vinculada y verificada (entró con GitHub o la vinculó después desde Google o correo), queda como `githubVerified: true` y `githubSource: \"clerk\"`; si la desvinculó, pasa a `declared`. El cliente debe llamar este endpoint al volver del flujo de vinculación de Clerk. Difiere del ERS: la verificación (RF-S1-10) la resuelve Clerk, por eso no existen `/api/auth/github` ni su callback.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Otra cuenta ya tiene verificado ese usuario de GitHub.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "GITHUB_USERNAME_TAKEN",
                    "message": "Ese usuario de GitHub ya está registrado en otra cuenta."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error propio o de Clerk/base de datos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Error interno del servidor."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateProfile",
        "tags": [
          "auth"
        ],
        "summary": "Declarar el usuario de GitHub",
        "description": "Para quien aún no vinculó GitHub en Clerk: el usuario queda declarado (`githubVerified: false`) y sirve para reconocerlo en un PR. Es único entre cuentas. `null` lo quita. Si el usuario ya tiene uno verificado por Clerk no se puede pisar a mano.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "githubUsername": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-z\\d](?:[a-z\\d]|-(?=[a-z\\d])){0,38}$",
                        "description": "Usuario de GitHub, sin `@`. Se guarda en minúscula.",
                        "example": "octocat"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Usuario de GitHub declarado a mano (queda sin verificar). `null` lo quita."
                  }
                },
                "required": [
                  "githubUsername"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Usuario de GitHub inválido (`VALIDATION_ERROR`, con `details` por campo).",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Datos invalidos",
                    "details": {
                      "githubUsername": [
                        "El usuario de GitHub no es válido."
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`GITHUB_USERNAME_TAKEN`: otra cuenta ya usa ese usuario de GitHub. `GITHUB_VERIFIED`: el usuario ya está verificado con la cuenta vinculada en Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "GITHUB_USERNAME_TAKEN",
                    "message": "Ese usuario de GitHub ya está registrado en otra cuenta."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error propio o de Clerk/base de datos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Error interno del servidor."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace": {
      "get": {
        "operationId": "listWorkspaces",
        "tags": [
          "workspace"
        ],
        "summary": "Listar mis espacios de trabajo",
        "description": "Solo los espacios donde el usuario es miembro, ordenados por nombre. Nunca incluye `inviteCode`. `decisionCount` y `pending` valen 0 hasta que existan las decisiones (ERS sprint 2); el contrato ya los incluye. Difiere del ERS (`GET /api/workspaces`): la ruta real es singular.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista (vacía si el usuario no es miembro de ninguno).",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": "0f8fad5b-d9cb-469f-a165-70867728950e",
                    "name": "Equipo Plataforma",
                    "imageUrl": null,
                    "role": "MEMBER",
                    "memberCount": 4,
                    "decisionCount": 0,
                    "pending": {
                      "respond": 0,
                      "review": 0
                    }
                  }
                ],
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkspaceListItem"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error propio o de Clerk/base de datos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Error interno del servidor."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createWorkspace",
        "tags": [
          "workspace"
        ],
        "summary": "Crear un espacio de trabajo",
        "description": "El usuario autenticado queda como `OWNER`.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Espacio creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (`VALIDATION_ERROR`, con `details` por campo) o ID ausente. Un JSON mal formado lo rechaza Express antes del controlador, con su respuesta por defecto (no usa este formato).",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Datos invalidos",
                    "details": {
                      "name": [
                        "El nombre es obligatorio."
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error propio o de Clerk/base de datos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Error interno del servidor."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/join": {
      "post": {
        "operationId": "joinWorkspace",
        "tags": [
          "workspace"
        ],
        "summary": "Unirse a un espacio con código de invitación",
        "description": "El código se normaliza (sin espacios ni guiones, en mayúsculas) antes de comparar. El usuario queda como `MEMBER`. Difiere del ERS (`POST /api/workspaces/join`): la ruta real es singular.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Código de invitación. Se ignoran espacios, guiones y mayúsculas/minúsculas.",
                    "example": "ZP4M-8QDX"
                  }
                },
                "required": [
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Se unió; mismo ítem que el listado, con `role: \"MEMBER\"`.",
            "content": {
              "application/json": {
                "example": {
                  "id": "0f8fad5b-d9cb-469f-a165-70867728950e",
                  "name": "Equipo Plataforma",
                  "imageUrl": null,
                  "role": "MEMBER",
                  "memberCount": 4,
                  "decisionCount": 0,
                  "pending": {
                    "respond": 0,
                    "review": 0
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListItem"
                }
              }
            }
          },
          "400": {
            "description": "Falta el código (`VALIDATION_ERROR`, con `details` por campo).",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Datos invalidos",
                    "details": {
                      "code": [
                        "El código de invitación es obligatorio."
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Ningún espacio tiene ese código.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INVALID_INVITE_CODE",
                    "message": "El código de invitación no es válido."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "El usuario ya era miembro (`ALREADY_MEMBER`). `details.workspace` trae el mismo ítem del listado, con el rol que ya tenía (puede ser `OWNER`).",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "ALREADY_MEMBER",
                    "message": "Ya sos miembro de Equipo Plataforma.",
                    "details": {
                      "workspace": {
                        "id": "0f8fad5b-d9cb-469f-a165-70867728950e",
                        "name": "Equipo Plataforma",
                        "imageUrl": null,
                        "role": "MEMBER",
                        "memberCount": 4,
                        "decisionCount": 0,
                        "pending": {
                          "respond": 0,
                          "review": 0
                        }
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error propio o de Clerk/base de datos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Error interno del servidor."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspace/{id}": {
      "get": {
        "operationId": "getWorkspace",
        "tags": [
          "workspace"
        ],
        "summary": "Obtener un espacio de trabajo",
        "description": "Solo para miembros del espacio. Incluye el `role` del usuario y `memberCount`. `inviteCode` solo se devuelve si el usuario es `OWNER`.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "ID del espacio de trabajo.",
              "example": "0f8fad5b-d9cb-469f-a165-70867728950e"
            },
            "required": true,
            "description": "ID del espacio de trabajo."
          }
        ],
        "responses": {
          "200": {
            "description": "El espacio, con la membresía del usuario.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWithMembership"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (`VALIDATION_ERROR`, con `details` por campo) o ID ausente. Un JSON mal formado lo rechaza Express antes del controlador, con su respuesta por defecto (no usa este formato).",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Datos invalidos",
                    "details": {
                      "name": [
                        "El nombre es obligatorio."
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El usuario no es miembro.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "No estás autorizado a acceder al espacio de trabajo."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "Espacio de trabajo no encontrado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error propio o de Clerk/base de datos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Error interno del servidor."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateWorkspace",
        "tags": [
          "workspace"
        ],
        "summary": "Modificar un espacio de trabajo",
        "description": "Solo el `OWNER`.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "ID del espacio de trabajo.",
              "example": "0f8fad5b-d9cb-469f-a165-70867728950e"
            },
            "required": true,
            "description": "ID del espacio de trabajo."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "imageUrl": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Espacio actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos (`VALIDATION_ERROR`, con `details` por campo) o ID ausente. Un JSON mal formado lo rechaza Express antes del controlador, con su respuesta por defecto (no usa este formato).",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Datos invalidos",
                    "details": {
                      "name": [
                        "El nombre es obligatorio."
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión válida de Clerk.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Usuario no autenticado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "El usuario no es `OWNER`.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "No estás autorizado a modificar el espacio de trabajo."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No existe.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "Espacio de trabajo no encontrado."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error propio o de Clerk/base de datos.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Error interno del servidor."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteWorkspace",
        "tags": [
          "workspace"
        ],
        "summary": "Eliminar un espacio de trabajo",
        "description": "Solo el `OWNER`. Borra también sus miembros.",
        "security": [
          {
            "clerkSession": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "ID del espacio de trabajo.",
              "example": "0f8fad5b-d9cb-469f-a165-70867728950e"
            },
            "required": true,
            "description": "ID del espacio de trabajo."
          }
        ],
        "responses": {
          "204": {
            "description": "Eliminado, sin cuerpo."
          },
          "400": {
            "description": "Datos inválidos (`VALIDATION_ERROR`, con `details` por campo) o ID ausente. Un JSON mal formado lo rechaza Express antes del controlador, con su respuesta por defecto (no usa este formato).",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Datos invalidos",
                    "details": {
                      "name": [
                        "El nombre es obligatorio."
                      ]
                    }
                  }
