    "securitySchemes": {
      "clerkSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token de sesión de Clerk en `Authorization: Bearer <token>` (la cookie `__session` también lo satisface). `clerkMiddleware()` no bloquea por sí solo: el 401 lo emite cada controlador."
      }
    }
