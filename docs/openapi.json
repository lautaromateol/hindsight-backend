              {
                "$ref": "#/components/schemas/GithubSource"
              },
              {
                "type": "null"
              }
            ],
            "description": "`clerk` si está verificado, `declared` si lo escribió a mano, `null` si no tiene. Con `declared` o `null` el cliente puede ofrecer vincular GitHub."
          }
        },
        "required": [
          "userId",
          "name",
          "imageUrl",
          "githubUsername",
          "githubVerified",
          "githubSource"
        ],
        "additionalProperties": false
      },
      "GithubSource": {
        "type": "string",
        "enum": [
          "clerk",
          "declared"
        ]
      },
      "WorkspaceListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "imageUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/WorkspaceRole"
          },
          "memberCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "decisionCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
