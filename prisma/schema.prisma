generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id         String   @id @default(uuid())
  name       String
  imageUrl   String?
  members    Member[]
  inviteCode String   @unique
}

model Member {
  id          String    @id @default(uuid())
  userId      String
  name        String
  imageUrl    String?
  role        Role
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([workspaceId, userId])
}

// Perfil por usuario de Clerk. El usuario de GitHub es único entre cuentas (RF-S1-07);
// githubVerified indica que Clerk lo verificó con una cuenta GitHub vinculada (RF-S1-10).
model Profile {
  userId         String  @id
  githubUsername String? @unique
  githubVerified Boolean @default(false)
}

enum Role {
  MEMBER
  OWNER
}
