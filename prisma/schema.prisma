generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id         String   @id @default(uuid())
  name       String
  imageUrl   String?
  members    Member[]
  inviteCode String   @unique
}

model Member {
  id          String    @id @default(uuid())
  userId      String
  name        String
  imageUrl    String?
  role        Role
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId String

  @@unique([workspaceId, userId])
}

enum Role {
  MEMBER
  OWNER
}
