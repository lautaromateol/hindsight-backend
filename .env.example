# Prisma Postgres — Console > Database > Connect
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Clerk — Dashboard > API keys
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Seguridad por filas (docs/rls.md). DATABASE_URL es la de la API y debe usar el rol escolio_app;
# las migraciones corren con el dueño de las tablas. Sin MIGRATION_DATABASE_URL se usa DATABASE_URL.
# MIGRATION_DATABASE_URL="postgres://OWNER:PASSWORD@host:5432/postgres?sslmode=require"
